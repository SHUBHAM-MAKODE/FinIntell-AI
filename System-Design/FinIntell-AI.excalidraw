    {
      "id": "yfubrUS41BTDPVWi3iP92",
      "type": "text",
      "x": -24155.338590500993,
      "y": -117136.30856075617,
      "width": 427.3597412109375,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3i",
      "roundness": null,
      "seed": 400380603,
      "version": 1149,
      "versionNonce": 2136269893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792227041616,
      "created": 1792127306244,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n1. Performance and Responsiveness\n        - API response latency (P95<200ms)\n        - Asynchronous OCR latency (<3.0s)\n        - Non blocking I/O\n        - UI Fluidity ( INP metric <200ms)\n2. Security and Isolation\n        - password hashing\n        - stateless \"jwt\"signing\n        - https / TLS encryption\n        - CSRF\n        - Strict multi-tenant data Isolation\n3. Scalability and Database Efficiency\n        - 'HikariCP' connection Pooling\n        - Indexing strategy\n        - Stateless container execution \n4. Reliability and data Integrity'\n        - ACID financial Compliance\n        - Schema versioning\n        - Global Exception Mapping\n        - External AI API resilience\n5. Code Maintainability and usability\n        - Layered architecture\n        - open API documentation\n        - Responsive Design",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "eJPzlw8AEH6_zOZzYOUUo",
      "originalText": "Non Functional Requirements\n1. Performance and Responsiveness\n        - API response latency (P95<200ms)\n        - Asynchronous OCR latency (<3.0s)\n        - Non blocking I/O\n        - UI Fluidity ( INP metric <200ms)\n2. Security and Isolation\n        - password hashing\n        - stateless \"jwt\"signing\n        - https / TLS encryption\n        - CSRF\n        - Strict multi-tenant data Isolation\n3. Scalability and Database Efficiency\n        - 'HikariCP' connection Pooling\n        - Indexing strategy\n        - Stateless container execution \n4. Reliability and data Integrity'\n        - ACID financial Compliance\n        - Schema versioning\n        - Global Exception Mapping\n        - External AI API resilience\n5. Code Maintainability and usability\n        - Layered architecture\n        - open API documentation\n        - Responsive Design",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
