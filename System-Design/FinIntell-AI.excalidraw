    {
      "id": "YKt_3X0-xl8qLrAC4EdH1",
      "type": "text",
      "x": -24956.027832949465,
      "y": -117176.97416842115,
      "width": 433.43963623046875,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3m",
      "roundness": null,
      "seed": 1645158197,
      "version": 762,
      "versionNonce": 1996626373,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792227041616,
      "created": 1792127303797,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. User Authentication and Access Control\n        - Account registration\n        - Secure login and token Issuance\n- Request Authorization\n        - Logout and Session Control\n2. Expense and Budget Management\n        - Expense logging\n        - Querying and Filtering\n        - Transaction Modifications\n        - Category Thresholds and Alerts\n3. AI-Powered Receipt OCR and Extraction\n        - Document Upload\n        - Asynchronous Job Execution\n        - Vision OCR parsing \n        - One Click Expense Conversion\n4. Conversational AI Financial Assistant\n                 (RAG engine)\n        - Vector Embedding Ingestion\n        - Natural Language Inquireies\n        - Similarity Vector Search\n        - Grounded Answer Generation\n5. Interactive Visual Analytic and dashboard\n        - Real time financial KPIs\n        - Monthly Expenditure Trends\n        - Category break down",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "j6mjFuYLTbfvW8nh8HRsE",
      "originalText": "Functional Requirements\n1. User Authentication and Access Control\n        - Account registration\n        - Secure login and token Issuance\n- Request Authorization\n        - Logout and Session Control\n2. Expense and Budget Management\n        - Expense logging\n        - Querying and Filtering\n        - Transaction Modifications\n        - Category Thresholds and Alerts\n3. AI-Powered Receipt OCR and Extraction\n        - Document Upload\n        - Asynchronous Job Execution\n        - Vision OCR parsing \n        - One Click Expense Conversion\n4. Conversational AI Financial Assistant\n                 (RAG engine)\n        - Vector Embedding Ingestion\n        - Natural Language Inquireies\n        - Similarity Vector Search\n        - Grounded Answer Generation\n5. Interactive Visual Analytic and dashboard\n        - Real time financial KPIs\n        - Monthly Expenditure Trends\n        - Category break down",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
